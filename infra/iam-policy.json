{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "InvokeNovaMicro",
            "Effect": "Allow",
            "Action": [
                "bedrock:InvokeModel",
                "bedrock:InvokeModelWithResponseStream"
            ],
            "Resource": "arn:aws:bedrock:*::foundation-model/amazon.nova-micro-v1:0"
        },
        {
            "Sid": "ReadCloudFacts",
            "Effect": "Allow",
            "Action": [
                "dynamodb:Scan",
                "dynamodb:GetItem"
            ],
            "Resource": "arn:aws:dynamodb:*:*:table/CloudFacts"
        }
    ]
}
